<!-- 상단 소개글 -->
<div class="top">
  <h1 class="top-heading">UEFA Champions League 24/25</h1>
  <p class="top-body">Explore the latest match results and upcoming fixtures.</p>
</div>

<!-- 최근 경기 -->
<section class="articles">
  <h2 class="articles-heading">Matches</h2>
  <div class="match-grid">
    <% data.forEach(match => { %>
      <a href="/match/<%= match._id %>" class="match-card">
        <div class="match-stage"><%= match.stage %></div>
        <div class="match-teams">
          <span><%= match.homeTeam %></span>
          <span class="match-score">
            <%= match.homeScore !== null ? match.homeScore : '-' %> : <%= match.awayScore !== null ? match.awayScore : '-' %>
          </span>
          <span><%= match.awayTeam %></span>
        </div>
        <div class="match-date"><%= match.matchDate ? match.matchDate.toLocaleDateString() : '' %></div>
      </a>
    <% }) %>
  </div>
</section>