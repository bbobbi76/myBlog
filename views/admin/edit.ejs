<a href="/allMatches">&larr; 대시보드로 돌아가기</a>
<div class="admin-title">
  <h2><%= locals.title %></h2>
</div>

<form action="/edit/<%= data._id %>?_method=PUT" method="POST">
  <label for="stage"><b>경기 단계 (예: 리그 페이즈 - 1차전)</b></label>
  <input type="text" placeholder="단계 입력" name="stage" id="stage" value="<%= data.stage %>" required>

  <label for="matchDate"><b>경기 날짜</b></label>
  <input type="date" name="matchDate" id="matchDate" value="<%= data.matchDate ? data.matchDate.toISOString().split('T')[0] : '' %>" required>

  <div style="display: flex; gap: 20px;">
    <div style="flex: 1;">
      <label for="homeTeam"><b>홈 팀</b></label>
      <input type="text" placeholder="홈 팀 이름" name="homeTeam" id="homeTeam" value="<%= data.homeTeam %>" required>
    </div>
    <div style="flex: 1;">
      <label for="homeScore"><b>홈 팀 점수</b></label>
      <input type="number" placeholder="점수 (아직 경기를 안했다면 비워두세요)" name="homeScore" id="homeScore" value="<%= data.homeScore !== null ? data.homeScore : '' %>">
    </div>
  </div>

  <div style="display: flex; gap: 20px;">
    <div style="flex: 1;">
      <label for="awayTeam"><b>원정 팀</b></label>
      <input type="text" placeholder="원정 팀 이름" name="awayTeam" id="awayTeam" value="<%= data.awayTeam %>" required>
    </div>
    <div style="flex: 1;">
      <label for="awayScore"><b>원정 팀 점수</b></label>
      <input type="number" placeholder="점수 (아직 경기를 안했다면 비워두세요)" name="awayScore" id="awayScore" value="<%= data.awayScore !== null ? data.awayScore : '' %>">
    </div>
  </div>
  
  <label for="description"><b>경기 요약 / 하이라이트</b></label>
  <textarea placeholder="경기 요약이나 메모를 적어주세요" name="description" cols="50" rows="5"><%= data.description %></textarea>

  <input type="submit" value="경기 수정하기" class="btn">
</form>

<form action="/delete/<%= data._id %>?_method=DELETE" method="POST" style="margin-top: 20px;">
  <input type="submit" value="경기 삭제하기" class="btn-delete btn">
</form>