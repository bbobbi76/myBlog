<div class="admin-title">
  <h2><%= locals.title %></h2>
  <a href="/add" class="btn">+ Add Match</a>
</div>

<ul class="admin-posts">
  <% data.forEach(match => { %>
    <li>
      <a href="/match/<%= match._id %>">
        <strong><%= match.stage %></strong> | <%= match.homeTeam %> vs <%= match.awayTeam %>
      </a>
      <div class="admin-post-controls">
        <a href="/edit/<%= match._id %>" class="btn">Edit</a>

        <form action="/delete/<%= match._id %>?_method=DELETE" method="POST">
          <input type="submit" value="Delete" class="btn-delete btn">
        </form>
      </div>
    </li>
  <% }) %>
</ul>